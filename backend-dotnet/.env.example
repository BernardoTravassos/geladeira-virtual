PORT=3333

# Banco de dados (dentro do docker-compose, o host é "db")
DATABASE_URL=postgresql://geladeira:geladeira@db:5432/geladeira_virtual

# Autenticação
# Gere um valor unico (nunca reutilize o de outro ambiente):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# IA (preencher com sua chave real, nunca commitar)
ANTHROPIC_API_KEY=
# Modelo usado na análise de foto do prato (padrão: claude-haiku-5-5, o mais barato).
# ANTHROPIC_MODEL=claude-haiku-5-5

# E-mail (SMTP). Usamos SMTP e não a API HTTP do provedor, para trocar de
# provedor mexendo só aqui. Valores abaixo são do Resend.
#
# Sem domínio verificado, o Resend aceita APENAS onboarding@resend.dev como
# remetente, e entrega APENAS no e-mail da sua própria conta Resend.
# Quando tiver domínio verificado, troque o EMAIL_REMETENTE.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
EMAIL_REMETENTE=onboarding@resend.dev

# Só quando a API estiver exposta por um túnel ou proxy SEU (ex.: demonstração
# para um cliente). Faz o limite de tentativas contar o IP real de cada pessoa
# em vez do IP do túnel. Ligado sem haver proxy na frente, qualquer um forja o
# próprio IP e escapa do limite — por isso fica desligado por padrão.
# TRUST_PROXY=true
