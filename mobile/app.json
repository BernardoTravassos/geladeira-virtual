{
  "expo": {
    "name": "Geladeira Virtual",
    "slug": "geladeira-virtual",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#1F5D3A"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F5D3A",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-monochrome.png"
      },
      "package": "com.geladeriavirtual.app",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_EXERCISE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "33b427fc-e5ae-41a4-a2cc-825128fc8b66"
      }
    },
    "owner": "geladeriavirtual",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/33b427fc-e5ae-41a4-a2cc-825128fc8b66"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Geladeira Virtual usa a câmera para fotografar seus pratos e sua geladeira.",
          "photosPermission": "O Geladeira Virtual acessa suas fotos para você anexar o prato."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
